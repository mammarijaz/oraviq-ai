{
  "name": "@oraviq/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types and constants shared by the API, the owner app, widgets and sites: the API contract.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": { "@oraviq/pricing": "workspace:*" },
  "devDependencies": { "tsup": "^8.5.0", "typescript": "^5.7.3" }
}
