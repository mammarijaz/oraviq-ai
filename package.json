{
  "name": "oraviq",
  "private": true,
  "version": "0.1.0",
  "description": "Oraviq AI: the AI front desk and unified inbox for dumpster rental companies",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @oraviq/api db:migrate",
    "db:seed": "pnpm --filter @oraviq/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  }
}
