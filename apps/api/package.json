{
  "name": "@oraviq/api",
  "version": "0.1.0",
  "description": "Oraviq API and worker (NestJS 11, Prisma 7, BullMQ, Socket.IO)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --runInBand",
    "test:e2e": "jest --runInBand --selectProjects e2e",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "nest start --watch",
    "dev:worker": "ts-node --transpile-only src/worker.ts",
    "test:unit": "jest --runInBand --selectProjects unit",
    "db:reset": "prisma migrate reset --force && ts-node --transpile-only prisma/seed.ts",
    "postinstall": "prisma generate",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.18",
    "@nestjs/swagger": "^11.2.7",
    "@nestjs/websockets": "^11.1.18",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@types/pg": "^8.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.10.1",
    "nestjs-cls": "^6.2.0",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "@oraviq/pricing": "workspace:*",
    "@oraviq/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.68.0",
    "stripe": "^19.1.0",
    "zod": "^3.25.0",
    "web-push": "^3.6.7",
    "@socket.io/redis-adapter": "^8.3.0",
    "helmet": "^8.1.0",
    "@nestjs/throttler": "^6.4.0",
    "dotenv": "^16.6.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "@types/web-push": "^3.6.4"
  },
  "jest": {
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "testTimeout": 30000,
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "rootDir": ".",
        "roots": [
          "<rootDir>/src"
        ],
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "tsconfig.json"
            }
          ]
        },
        "setupFiles": [
          "<rootDir>/test/env.ts"
        ]
      },
      {
        "displayName": "e2e",
        "testEnvironment": "node",
        "rootDir": ".",
        "roots": [
          "<rootDir>/test"
        ],
        "testRegex": ".*\\.e2e-spec\\.ts$",
        "transform": {
          "^.+\\.ts$": [
            "ts-jest",
            {
              "tsconfig": "tsconfig.json"
            }
          ]
        },
        "setupFiles": [
          "<rootDir>/test/env.ts"
        ]
      }
    ]
  }
}
