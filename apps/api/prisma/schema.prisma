// Oraviq data model (v1). Provider-neutral: no table is named after a vendor.
// Every tenant-owned table carries tenantId and is scoped by the tenant Prisma
// extension (src/prisma/tenant-prisma.ts). Money is integer cents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/* ------------------------------------------------------------------ enums */

enum Role {
  owner
  admin
  dispatcher
  staff
}

enum Channel {
  sms
  phone
  web_chat
  booking_form
  facebook
  instagram
  whatsapp
  email
}

/// Connections shown on the Setup / Connections page (superset of Channel).
enum ConnectionKind {
  sms
  phone
  facebook
  instagram
  google
  stripe
}

enum ConnectionStatus {
  connected
  not_connected
  pending
  error
}

enum ConversationState {
  needs_you
  assistant
  confirmed
  closed
}

enum AiMode {
  auto
  draft
  off
}

enum MessageDirection {
  inbound
  outbound
  internal
}

enum MessageAuthor {
  customer
  assistant
  owner
  system
}

enum MessageStatus {
  received
  queued
  sent
  delivered
  failed
  draft
}

enum ConsentPurpose {
  transactional
  marketing
}

enum ConsentStatus {
  granted
  revoked
}

enum ConsentSource {
  inbound_message
  widget_checkbox
  booking_form
  verbal_on_call
  owner_entered
}

enum DebrisType {
  household
  construction
  heavy
}

enum OrderStatus {
  requested
  confirmed
  deposit_paid
  scheduled
  delivered
  pickup_requested
  picked_up
  closed
  cancelled
}

enum Placement {
  driveway
  street
  other
}

enum CallOutcome {
  quote_given
  order_requested
  sent_to_you
  message_taken
  no_action
}

enum CallStatus {
  in_progress
  ended
}

enum ReceptionistMode {
  missed
  after_hours
  all
}

enum ReceptionistVoice {
  warm
  clear
  calm
}

enum ReviewSource {
  google
  facebook
}

enum ReviewRequestStatus {
  ready
  scheduled
  sent
  reviewed
  skipped
}

enum RegistrationStatus {
  not_started
  pending
  in_review
  approved
  rejected
}

enum VoiceRoute {
  receptionist
  forward
  voicemail
}

enum DomainStatus {
  none
  pending
  active
  error
}

enum JobStatus {
  pending
  processing
  done
  failed
  cancelled
}

enum WebhookStatus {
  received
  processing
  processed
  failed
  ignored
}

/* ------------------------------------------------------------------ tenants and users */

model Tenant {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  /// The business line customers already call (E.164).
  phone          String?
  city           String?
  state          String?
  timezone       String   @default("America/New_York")
  businessHours  Json
  /// Public key used by widgets and sites (pk_…).
  publishableKey String   @unique
  /// The Oraviq number unanswered calls forward to (E.164).
  oraviqNumber   String?
  /// Where owner alerts are texted (E.164). Defaults to the owner's phone.
  alertPhone     String?
  /// Deposit asked for when an order is confirmed, in cents (capped at the quote total).
  depositCents   Int      @default(10000)
  orderSeq       Int      @default(1000)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships Membership[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Membership {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  role      Role     @default(staff)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  tenantId     String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("refresh_tokens")
}

/* ------------------------------------------------------------------ contacts and consent */

model Contact {
  id          String   @id @default(uuid())
  tenantId    String
  name        String?
  email       String?
  company     String?
  notes       String?
  firstSeenAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  identities    ContactIdentity[]
  consents      Consent[]
  conversations Conversation[]
  orders        Order[]

  @@index([tenantId, createdAt])
  @@map("contacts")
}

/// One row per way to reach a contact: phone number, Messenger PSID, IG id, chat session.
model ContactIdentity {
  id                String   @id @default(uuid())
  tenantId          String
  contactId         String
  channel           Channel
  /// E.164 for phone/SMS; provider-scoped id otherwise.
  addressNormalized String
  displayAddress    String?
  createdAt         DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel, addressNormalized])
  @@index([tenantId, contactId])
  @@index([tenantId, addressNormalized])
  @@map("contact_identities")
}

/// Append-only consent ledger (TCPA evidence). Latest row per (contact, channel, purpose) wins.
model Consent {
  id          String         @id @default(uuid())
  tenantId    String
  contactId   String
  channel     Channel
  purpose     ConsentPurpose
  status      ConsentStatus
  source      ConsentSource
  evidence    Json
  textVersion String?
  capturedAt  DateTime       @default(now())
  revokedAt   DateTime?
  createdAt   DateTime       @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, channel, capturedAt])
  @@map("consents")
}

/* ------------------------------------------------------------------ channels and numbers */

model ChannelAccount {
  id                String           @id @default(uuid())
  tenantId          String
  kind              ConnectionKind
  provider          String
  externalAccountId String?
  externalName      String?
  status            ConnectionStatus @default(not_connected)
  /// Pointer to a secret in the secrets store; never the secret itself.
  credentialsRef    String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([tenantId, kind])
  @@index([provider, externalAccountId])
  @@map("channel_accounts")
}

model PhoneNumber {
  id                 String             @id @default(uuid())
  tenantId           String
  e164               String             @unique
  provider           String
  providerNumberId   String?
  forwardingFrom     String?
  registrationStatus RegistrationStatus @default(not_started)
  voiceRoute         VoiceRoute         @default(receptionist)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId])
  @@index([provider, providerNumberId])
  @@map("phone_numbers")
}

/* ------------------------------------------------------------------ inbox */

model Conversation {
  id                 String            @id @default(uuid())
  tenantId           String
  contactId          String
  channel            Channel
  state              ConversationState @default(assistant)
  tag                String?
  aiMode             AiMode            @default(auto)
  /// ConversationFacts gathered by the assistant.
  facts              Json              @default("{}")
  /// Internal assistant state (stage, intro sent, counters).
  aiState            Json              @default("{}")
  handoffReason      String?
  lastMessageAt      DateTime          @default(now())
  lastMessagePreview String            @default("")
  unread             Boolean           @default(true)
  assignedUserId     String?
  /// How the conversation started: inbound_message, missed_call, call, booking_form, web_chat, owner.
  origin             String            @default("inbound_message")
  /// Provider thread id (e.g. Zernio conversation id) or web chat session id.
  externalThreadId   String?
  /// Simulator conversations always route through the mock provider.
  simulated          Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  contact  Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages Message[]
  quotes   Quote[]
  orders   Order[]
  calls    Call[]

  @@index([tenantId, lastMessageAt])
  @@index([tenantId, state, lastMessageAt])
  @@index([tenantId, channel, lastMessageAt])
  @@index([tenantId, contactId])
  @@index([tenantId, externalThreadId])
  @@map("conversations")
}

model Message {
  id                String           @id @default(uuid())
  tenantId          String
  conversationId    String
  direction         MessageDirection
  author            MessageAuthor
  channel           Channel
  body              String
  status            MessageStatus
  provider          String?
  providerMessageId String?
  aiGenerated       Boolean          @default(false)
  aiTraceId         String?
  idempotencyKey    String?
  quoteId           String?
  meta              String?
  error             String?
  createdAt         DateTime         @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerMessageId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, createdAt])
  @@map("messages")
}

/* ------------------------------------------------------------------ calls */

model Call {
  id                String      @id @default(uuid())
  tenantId          String
  conversationId    String?
  contactId         String?
  provider          String
  providerCallId    String?
  agentId           String?
  callerNumber      String
  callerName        String?
  startedAt         DateTime    @default(now())
  endedAt           DateTime?
  durationSeconds   Int         @default(0)
  afterHours        Boolean     @default(false)
  status            CallStatus  @default(in_progress)
  outcome           CallOutcome @default(no_action)
  summary           String?
  /// [{ speaker: 'agent' | 'caller', text }]
  transcript        Json        @default("[]")
  transferredTo     String?
  recordingKey      String?
  disclosureVersion String?
  analysis          Json?
  /// Voice-brain state for simulated calls.
  aiState           Json        @default("{}")
  isTest            Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([provider, providerCallId])
  @@index([tenantId, startedAt])
  @@index([tenantId, outcome, startedAt])
  @@index([tenantId, conversationId])
  @@map("calls")
}

/* ------------------------------------------------------------------ pricing, quotes, orders */

/// Versioned price tables. The current table is the highest version.
model PriceTable {
  id            String   @id @default(uuid())
  tenantId      String
  version       Int
  rules         Json
  effectiveFrom DateTime @default(now())
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([tenantId, version])
  @@map("price_tables")
}

model Quote {
  id                String     @id @default(uuid())
  tenantId          String
  conversationId    String?
  contactId         String?
  /// The QuoteInput passed to @oraviq/pricing.
  inputs            Json
  /// The full Quote object returned by @oraviq/pricing.
  quote             Json
  lineItems         Json
  totalCents        Int
  priceTableVersion Int
  yards             Int
  days              Int
  zip               String
  debris            DebrisType
  /// renderQuoteSentence(quote)
  sentence          String
  createdAt         DateTime   @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([tenantId, conversationId, createdAt])
  @@index([tenantId, createdAt])
  @@map("quotes")
}

model Order {
  id                String      @id @default(uuid())
  tenantId          String
  number            String
  status            OrderStatus @default(requested)
  contactId         String
  conversationId    String?
  quoteId           String?
  channel           Channel
  address           String
  zip               String?
  placement         Placement   @default(driveway)
  permitCheck       Boolean     @default(false)
  /// ISO date (YYYY-MM-DD) or the customer's phrase ("Thursday").
  deliveryDate      String?
  deliveryDateLabel String      @default("")
  deliveryWindow    String?
  depositRequested  Boolean     @default(false)
  depositPaid       Boolean     @default(false)
  depositUrl        String?
  depositCents      Int?
  paymentProvider   String?
  paymentSessionId  String?
  paidAt            DateTime?
  notes             String?
  /// assistant, voice, booking_form, owner, seed
  source            String      @default("owner")
  createdByAi       Boolean     @default(false)
  deliveredAt       DateTime?
  pickedUpAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  quote        Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  events       OrderEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, contactId])
  @@index([tenantId, conversationId])
  @@index([paymentSessionId])
  @@map("orders")
}

model OrderEvent {
  id          String       @id @default(uuid())
  tenantId    String
  orderId     String
  kind        String
  fromStatus  OrderStatus?
  toStatus    OrderStatus?
  data        Json?
  actorUserId String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId, createdAt])
  @@map("order_events")
}

/* ------------------------------------------------------------------ settings */

model ReceptionistSettings {
  id                       String            @id @default(uuid())
  tenantId                 String            @unique
  enabled                  Boolean           @default(true)
  mode                     ReceptionistMode  @default(missed)
  greeting                 String
  voice                    ReceptionistVoice @default(warm)
  transferWhenAsked        Boolean           @default(true)
  transferWhenOutsideRules Boolean           @default(true)
  transferNumber           String?
  spanish                  Boolean           @default(false)
  voiceProvider            String            @default("mock")
  agentId                  String?
  updatedAt                DateTime          @updatedAt

  @@map("receptionist_settings")
}

model ReviewRequestSettings {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  enabled      Boolean  @default(true)
  delayMinutes Int      @default(120)
  template     String
  reviewLink   String?
  updatedAt    DateTime @updatedAt

  @@map("review_request_settings")
}

model SiteSettings {
  id                 String       @id @default(uuid())
  tenantId           String       @unique
  slug               String       @unique
  customDomain       String?      @unique
  customDomainStatus DomainStatus @default(none)
  customHostnameId   String?
  published          Boolean      @default(false)
  publishedAt        DateTime?
  headline           String
  intro              String
  accentColor        String       @default("#1F6B4F")
  sections           Json
  updatedAt          DateTime     @updatedAt

  @@map("site_settings")
}

model WidgetSettings {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  chatGreeting    String
  chatButtonLabel String   @default("Get a price")
  chatPosition    String   @default("right")
  accentColor     String   @default("#1F6B4F")
  updatedAt       DateTime @updatedAt

  @@map("widget_settings")
}

/* ------------------------------------------------------------------ reviews */

model Review {
  id            String       @id @default(uuid())
  tenantId      String
  source        ReviewSource
  externalId    String?
  author        String
  rating        Int?
  recommends    Boolean?
  text          String
  customerPhone String?
  contactId     String?
  reply         String?
  repliedAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  drafts ReviewReplyDraft[]

  @@unique([tenantId, source, externalId])
  @@index([tenantId, createdAt])
  @@map("reviews")
}

model ReviewReplyDraft {
  id          String   @id @default(uuid())
  tenantId    String
  reviewId    String
  text        String
  aiGenerated Boolean  @default(true)
  aiTraceId   String?
  createdAt   DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([tenantId, reviewId, createdAt])
  @@map("review_reply_drafts")
}

/// Aggregate rating per review source, synced from the reviews provider.
model ReviewSourceStats {
  id           String       @id @default(uuid())
  tenantId     String
  source       ReviewSource
  rating       Float?
  recommendPct Int?
  count        Int          @default(0)
  syncedAt     DateTime     @default(now())

  @@unique([tenantId, source])
  @@map("review_source_stats")
}

model ReviewRequest {
  id        String              @id @default(uuid())
  tenantId  String
  orderId   String
  contactId String
  status    ReviewRequestStatus
  sendAt    DateTime?
  sentAt    DateTime?
  messageId String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([tenantId, orderId])
  @@index([tenantId, createdAt])
  @@map("review_requests")
}

/* ------------------------------------------------------------------ plumbing */

model WebhookEvent {
  id              String        @id @default(uuid())
  provider        String
  externalEventId String
  type            String
  tenantId        String?
  payload         Json
  status          WebhookStatus @default(received)
  attempts        Int           @default(0)
  error           String?
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}

/// Transactional outbox: side effects and realtime events written with the state change.
model Outbox {
  id          String    @id @default(uuid())
  tenantId    String?
  kind        String
  payload     Json
  status      JobStatus @default(pending)
  attempts    Int       @default(0)
  availableAt DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, availableAt])
  @@index([tenantId, createdAt])
  @@map("outbox")
}

/// Durable delayed work (review requests, owner reminders). Redis only executes.
model ScheduledAction {
  id        String    @id @default(uuid())
  tenantId  String
  kind      String
  runAt     DateTime
  payload   Json
  status    JobStatus @default(pending)
  attempts  Int       @default(0)
  dedupeKey String?
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([status, runAt])
  @@index([tenantId, kind])
  @@map("scheduled_actions")
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  data        Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String?
  title     String
  body      String
  href      String?
  /// Delivery record: { sms?: { to, providerMessageId }, push?: number }
  delivery  Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  keys      Json
  createdAt DateTime @default(now())

  @@index([tenantId, userId])
  @@map("push_subscriptions")
}
