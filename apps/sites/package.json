{
  "name": "@oraviq/sites",
  "version": "0.1.0",
  "private": true,
  "description": "Hauler websites: Astro SSR, one page per tenant resolved from the Host header.",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4321",
