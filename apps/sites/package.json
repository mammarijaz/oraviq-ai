    "@oraviq/pricing": "workspace:*",
    "@oraviq/shared": "workspace:*",
    "@oraviq/ui-tokens": "workspace:*",
    "astro": "^5.12.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}