{
  "name": "@oraviq/widgets",
  "version": "0.1.0",
  "private": true,
  "description": "Embeddable widgets: a tiny loader (Shadow DOM launcher) plus iframe apps for chat and instant-price booking.",
  "type": "module",
  "scripts": {
    "dev": "vite build --config vite.loader.config.ts --watch & vite --port 5175",
    "build": "vite build && vite build --config vite.loader.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oraviq/pricing": "workspace:*",
    "@oraviq/shared": "workspace:*",
    "@oraviq/ui": "workspace:*",
    "@oraviq/ui-tokens": "workspace:*",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}