# Oraviq environment. Copy to .env (repo root) or apps/api/.env and fill in.
# Any provider key left empty runs that adapter in MOCK mode, so the whole
# product works locally and in CI with no outside accounts.

# ---------------------------------------------------------------- core
NODE_ENV=development
# HTTP port for apps/api
PORT=3000
# Postgres (docker compose up -d, or a local cluster). Role oraviq/oraviq.
DATABASE_URL=postgresql://oraviq:oraviq@localhost:5432/oraviq?schema=public
# Redis executes BullMQ jobs and fans out realtime events between processes.
REDIS_URL=redis://localhost:6379
# Run BullMQ processors, the outbox publisher and the scheduled-actions poller
# inside the API process (no separate worker, no Redis needed). Use for local dev and tests.
INLINE_JOBS=true

# ---------------------------------------------------------------- auth
# Sign access tokens (15 min) and refresh tokens (30 days). Use long random strings.
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# ---------------------------------------------------------------- URLs
# Public base URL of the API (webhooks, Retell custom functions, payment return links).
PUBLIC_API_URL=http://localhost:3000
# Owner app (Vue PWA). Allowed CORS origin for authenticated routes.
WEB_URL=http://localhost:5173
# Widgets origin (chat + booking iframes). /public routes allow any origin.
WIDGETS_URL=http://localhost:5174
# Free hauler sites live at <slug>.<SITES_BASE_DOMAIN>
SITES_BASE_DOMAIN=oraviq.site

# ---------------------------------------------------------------- AI (LlmProvider)
# Empty = deterministic mock assistant ported from the prototype.
ANTHROPIC_API_KEY=
# Claude Haiku 4.5 by default.
ANTHROPIC_MODEL=claude-haiku-4-5

# ---------------------------------------------------------------- Zernio (SMS, numbers, Messenger/Instagram, reviews)
# Empty = mock messaging, telephony and reviews.
ZERNIO_API_KEY=
# The secret you set on the Zernio webhook endpoint (X-Zernio-Signature, HMAC-SHA256 hex).
ZERNIO_WEBHOOK_SECRET=
# Optional override of the API base (default https://zernio.com/api)
ZERNIO_API_URL=

# ---------------------------------------------------------------- Retell (voice agent)
# Empty = mock voice brain. The API key also verifies x-retell-signature on webhooks and custom functions.
RETELL_API_KEY=
# Optional: a webhook-badged key used only for signature checks (defaults to RETELL_API_KEY).
RETELL_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Stripe Connect (deposits)
# Empty = mock payments (https://pay.oraviq.test links + a dev "mark paid" endpoint).
STRIPE_SECRET_KEY=
# Connect webhook endpoint secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
# OAuth client id (ca_…) for Standard-style connected accounts.
STRIPE_CONNECT_CLIENT_ID=

# ---------------------------------------------------------------- Cloudflare for SaaS (custom domains)
# Empty = mock domains (hostnames go active instantly).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ---------------------------------------------------------------- Web push (owner alerts in the PWA)
# Empty = push is recorded but not delivered. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@oraviq.ai
